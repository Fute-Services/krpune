# Repository-root ignores.
# NOTE: code/.gitignore only governs code/ — these rules protect the root, where
# an untracked .env (Mapbox token) and multi-hundred-MB build output otherwise sit
# one `git add -A` away from being committed to a repo with public releases.

# Local env files — never commit
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Build output
.vite/
dist/
dist.zip
build/
out/

# desktop/build is not build output: it is where electron-builder looks for the
# packaging resources, and icon.ico lives there. `build/` above was swallowing
# it, so CI checked out a tree without the icon and every Windows build died on
# "cannot find specified resource build/icon.ico". The directory has to be
# re-included before a file inside it can be.
!desktop/build/
!desktop/build/**

# Electron build output — large binaries, never commit
release/
*.exe
*.blockmap

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Editor / OS junk
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db

# Vercel CLI link + the .env.local it pulls down (already covered by .env.* above,
# so no bare `.env*` here — that would re-ignore .env.example)
.vercel
