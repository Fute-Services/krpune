# What Vercel must NOT upload. Without this the CLI ships ~7.3 GB (Electron
# build output, test artifacts, node_modules) and the upload times out.
# Vercel installs deps and runs `cd web && npm run build` itself, so only the
# web/ source and web/public assets need to travel.

node_modules

# NOTE: this only applies to `vercel` CLI uploads. Production deploys come from
# the GitHub integration, where Vercel clones the repo itself and .git IS
# present — which is what lets scripts/vercel-build.sh run `git lfs pull`.
# A CLI deploy has no .git, so the LFS videos cannot be fetched and the build
# script will stop rather than ship pointer files. Deploy via git push.
.git

# Build output — Vercel rebuilds these
dist
build
out
release
*.exe
*.blockmap
*.zip

# Electron desktop app — the web deploy never touches it
desktop

# Test artifacts and local caches
test-results
playwright-report
.vite

# Source panoramas kept for re-encoding; only the optimized copies ship
web/.media-originals

# Local-only material
image backups
docs
