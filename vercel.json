{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd code && npm install",
  "buildCommand": "cd code && npm run build",
  "outputDirectory": "code/dist",
  "framework": null,
  "headers": [
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
