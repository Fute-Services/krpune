# The project guide (the chatbot). Without VITE_GROQ_API_KEY the guide's pill
# does not appear at all and the rest of the app is unaffected.
#
# WARNING: these keys ship inside the JavaScript bundle and are readable by
# anyone who opens the deployed site's devtools. Use keys created for this kiosk
# alone, keep a spend limit on each in its provider console, and treat rotating
# one as a redeploy.
#
# On Vercel: Project -> Settings -> Environment Variables.

# Groq — the conversation (openai/gpt-oss-120b) and the microphone
# (whisper-large-v3-turbo). Required.
VITE_GROQ_API_KEY=gsk_...

# ElevenLabs — the spoken voice. Optional: without it the guide still speaks,
# using the browser's own built-in voice, which is noticeably more robotic.
VITE_ELEVENLABS_API_KEY=sk_...

# Optional. Defaults to "Sarah" (EXAVITQu4vr4xnSDxMaL) — mature, reassuring.
# Any voice id from https://elevenlabs.io/app/voice-library works.
VITE_ELEVENLABS_VOICE_ID=
